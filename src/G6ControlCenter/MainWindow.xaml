<Window x:Class="G6ControlCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:G6ControlCenter" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="G6 Control" Width="940" Height="748" MinWidth="820" MinHeight="650" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource ForegroundBrush}" FontFamily="Segoe UI" FontSize="13">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="162"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="2" Background="{StaticResource WindowBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
   <TextBlock Text="G6 Control" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,0,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeClick" AutomationProperties.Name="Свернуть"/>
    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeClick" AutomationProperties.Name="Развернуть"/>
    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseClick" AutomationProperties.Name="Закрыть в трей"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#1D222C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="14,24,14,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,0,0,26"><Image x:Name="BrandIcon" Width="44" Height="44" HorizontalAlignment="Left"/><TextBlock Text="G6 Control" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="Личная панель" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="HomeNav" Style="{StaticResource Nav}" Click="HomeClick" Background="{DynamicResource SoftAccentBrush}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,10,0"/><TextBlock Text="Главная"/></StackPanel></Button><Button x:Name="CoolingNav" Style="{StaticResource Nav}" Click="CoolingClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,10,0"/><TextBlock Text="Охлаждение"/></StackPanel></Button></StackPanel>
    <StackPanel Grid.Row="3" Margin="8,0"><TextBlock Text="0.2.0" Style="{StaticResource Caption}"/><Button Content="Выход" Click="ExitClick" Background="Transparent" Margin="0,15,0,0" Padding="8,7"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageHeading" Text="Главная" FontSize="19" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock x:Name="SourceText" Text="Определяем питание" Style="{StaticResource Muted}"/></StackPanel></Grid></Border>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="26,22,26,20">
     <StackPanel x:Name="HomePage">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ProfileTitle" Text="Работа" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="ProfileSubtitle" Text="Тихо. Прохладно. Без лишнего." Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource SoftAccentBrush}" CornerRadius="14" Padding="16,12" VerticalAlignment="Center"><Image x:Name="ProfileIcon" Width="28" Height="28"/></Border></Grid>
      <Grid Margin="0,20,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="WorkButton" Click="WorkClick" Padding="12,11"><StackPanel><TextBlock Text="Работа" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Тихо" HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Button><Button x:Name="GameButton" Grid.Column="2" Click="GameClick" Padding="12,11"><StackPanel><TextBlock Text="Игра" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="GameHint" Text="Только от сети" HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Button><Button x:Name="BatteryButton" Grid.Column="4" IsEnabled="False" Padding="12,11"><StackPanel><TextBlock Text="АКБ" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Автоматически" HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Button></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="ПРОЦЕССОР" Style="{StaticResource Caption}"/><TextBlock x:Name="CpuLoadText" Text="—" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid><TextBlock x:Name="CpuTemperature" Text="— °C" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock x:Name="CpuFan" Text="— об/мин" Style="{StaticResource Muted}"/><TextBlock x:Name="CpuPolicy" Text="Ожидаем применения профиля" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="GEFORCE RTX 4050" Style="{StaticResource Caption}"/><TextBlock x:Name="GpuTemperature" Text="— °C" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock x:Name="GpuFan" Text="— об/мин" Style="{StaticResource Muted}"/><TextBlock x:Name="GpuPolicy" Text="Штатное управление графикой" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel></Border></Grid>
      <StackPanel Margin="0,18,0,16"><TextBlock Text="Экран" Style="{StaticResource Caption}"/><TextBlock x:Name="RefreshText" Text="— Гц" Margin="0,4,0,0"/></StackPanel>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BatteryPercent" Text="Батарея —" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BatteryDetail" Text="Получаем состояние батареи" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="BatteryRate" Text="— Вт" HorizontalAlignment="Right"/><TextBlock x:Name="ChargeText" Text="Проверяем порог заряда…" Style="{StaticResource Caption}" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
      <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><CheckBox x:Name="AutoSportToggle" Checked="SettingsChanged" Unchecked="SettingsChanged" ToolTip="CPU ≥80% в течение 15 с — Игра; ниже 25% в течение 45 с — Работа. Только от сети."><TextBlock Text="Повышать производительность&#x0a;при нагрузке"/></CheckBox><TextBlock Text="Автоматически · только от сети" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CoolButton" Content="Охладить · 60 с" Click="CoolClick" Margin="0,0,8,0"/><Button x:Name="AutoButton" Content="Вернуть автомат" Click="AutoClick"/></StackPanel></Grid>
     </StackPanel>
     <StackPanel x:Name="CoolingPage" Visibility="Collapsed">
      <TextBlock Text="Настройка охлаждения" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Кривая выполняется контроллером ноутбука. Начальная и конечная точки фиксированы." Style="{StaticResource Muted}" Margin="0,7,0,15"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="ПРОЦЕССОР" Style="{StaticResource Caption}"/><local:CurveEditor x:Name="CpuCurveEditor" Height="185" Margin="0,8,0,0"/><TextBlock x:Name="CpuCurveText" Style="{StaticResource Caption}" Text="Чтение заводской кривой…"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="ВИДЕОКАРТА" Style="{StaticResource Caption}"/><local:CurveEditor x:Name="GpuCurveEditor" Height="185" Margin="0,8,0,0"/><TextBlock x:Name="GpuCurveText" Style="{StaticResource Caption}" Text="Чтение заводской кривой…"/></StackPanel></Border></Grid>
      <TextBlock Text="Перетаскивай две средние точки. Изменения вступят в силу после применения." Style="{StaticResource Caption}" Margin="0,10,0,15"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CurveStateText" Text="Сейчас: штатное автоматическое охлаждение" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Заводские точки" Click="ResetCurveClick" Margin="0,0,8,0"/><Button x:Name="ApplyCurveButton" Content="Применить кривые" Style="{StaticResource Primary}" Click="ApplyCurveClick"/></StackPanel></Grid>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0"><StackPanel><TextBlock Text="Питание и экран" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="RefreshToggle" Content="Менять частоту экрана вместе с профилем" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,10,0,5"/><CheckBox x:Name="LightingToggle" Content="Цвет клавиатуры по профилю: синий / красный / зелёный" Checked="SettingsChanged" Unchecked="SettingsChanged"/><TextBlock Text="На АКБ: boost выключен, максимум CPU 85%. Работа: boost выключен. Игра: boost включён." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></Border>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ограничение заряда" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ChargeAvailability" Text="Проверяем доступные значения…" Style="{StaticResource Caption}" Margin="0,5,16,0"/></StackPanel><ComboBox x:Name="ChargeLimitBox" Grid.Column="1" Width="122" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource DarkComboBox}" AutomationProperties.Name="Максимальный заряд батареи"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}%}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="ChargeApplyButton" Content="Применить" Grid.Column="2" Click="ChargeClick" VerticalAlignment="Center"/></Grid></Border>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,15,0,0"><StackPanel><TextBlock Text="Запуск приложения" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="StartupToggle" Content="Запускать при входе в Windows" Checked="StartupChanged" Unchecked="StartupChanged" Margin="0,10,0,5"/><TextBlock x:Name="StartupDescription" Text="В трее, после входа в учётную запись" Style="{StaticResource Caption}"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Запуск…" Style="{StaticResource Caption}" MaxHeight="45"/><TextBlock Grid.Column="1" x:Name="SampleTime" Text="Без записи истории" Style="{StaticResource Caption}" Margin="15,0,0,0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
